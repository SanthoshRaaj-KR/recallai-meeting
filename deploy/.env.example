# ─────────────────────────────────────────────────────────────────────────────
# Jarvis deploy env reference. Copy to deploy/vm-a/.env and deploy/vm-b/.env and
# fill in. NEVER commit the filled files. (See SERVICE_MAP.md §8.)
# ─────────────────────────────────────────────────────────────────────────────

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Phase 3 (test): point at LiveKit Cloud.  Phase 6+: point at the self-hosted VM-A.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── VM-A: bot-service (8000) + agent ─────────────────────────────────────────
# Public HTTPS where Recall loads bot.html + posts webhooks (VM-A domain).
BRIDGE_SERVER_URL=https://vm-a.your-domain.com
# Localhost path the AGENT uses to post transcripts to bot-service.
#   bridge network (Win/Mac local + simple): http://bot-service:8000
#   host network (Linux prod VM):            http://127.0.0.1:8000
BRIDGE_INTERNAL_URL=http://bot-service:8000
RECALL_API_KEY=
RECALL_API_REGION=us-west-2
BOT_NAME=Meeting Assistant
AGENT_NAME=my-agent

# ── Models (unchanged providers) ─────────────────────────────────────────────
CEREBRAS_API_KEY=          # LLM (gpt-oss-120b) — agent + confluence-service
ASSEMBLYAI_API_KEY=        # STT — agent
CARTESIA_API_KEY=          # TTS — agent (replaces inference.TTS in Phase 4)
OPENAI_API_KEY=            # confluence-service pipeline fallback

# ── Confluence (VM-B confluence-service) ─────────────────────────────────────
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_DOMAIN=your-domain.atlassian.net
ATLASSIAN_SPACE_KEY=
MY_AGENT_REVIEW_MODEL=gpt-4o-mini
MY_AGENT_PIPELINE_MAX_PAGES=16

# ── Shared state ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PINECONE_API_KEY=

# ── Org/user-service (8003) ──────────────────────────────────────────────────
JWT_SECRET=change-me-strong-random
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
ALLOW_DB_RESET=false
# Admin "kick bot" proxy: org-service (VM-B) → bot-service (VM-A). Use the public
# VM-A bot URL (same host Recall uses), e.g. https://bot.<vm-a>.nip.io
BOT_SERVICE_URL=
# Optional shared secret sent as X-Internal-Secret on the kick proxy call.
INTERNAL_API_SECRET=

# ── CORS (set to the Static Web Apps origin in prod; * only for local) ───────
CORS_ORIGINS=*

# ── Optional ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
