// =============================================================================
// Grafana Alloy — VM-A (LiveKit box: bot-service :8000 + agent worker)
//
// Collects: host metrics (CPU/RAM/disk/net) + each app's Prometheus /metrics,
// receives OTLP traces from the apps, tails Docker container logs,
// and ships everything to Grafana Cloud.
// Credentials are read from the environment (see ../alloy.env).
//
// Run via deploy/vm-a/docker-compose.yml (alloy service).
// Local Alloy debug UI: http://<vm-a>:12345  (firewall this off in prod).
// =============================================================================

logging {
  level  = "info"
  format = "logfmt"
}

// ---- Grafana Cloud: metrics (Prometheus remote_write / Mimir) ---------------
prometheus.remote_write "grafanacloud" {
  endpoint {
    url = sys.env("GC_PROM_URL")
    basic_auth {
      username = sys.env("GC_PROM_USER")
      password = sys.env("GC_API_KEY")
    }
  }
  external_labels = {
    vm = "vm-a",
  }
}

// ---- Host metrics (node / unix exporter) ------------------------------------
// Host /, /proc, /sys are mounted read-only into the container by compose.
prometheus.exporter.unix "host" {
  rootfs_path = "/host/root"
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.grafanacloud.receiver]
  job_name        = "node"
  scrape_interval = "30s"
}

// ---- App metrics (each FastAPI /metrics + the agent worker) ------------------
prometheus.scrape "apps" {
  targets = [
    { "__address__" = "bot-service:8000", "service" = "bot-service" },
    { "__address__" = "agent:9464",       "service" = "agent-worker" },
  ]
  metrics_path    = "/metrics"
  forward_to      = [prometheus.remote_write.grafanacloud.receiver]
  job_name        = "jarvis-apps"
  scrape_interval = "15s"
}

// ---- Traces (OTLP in from apps → Grafana Cloud Tempo out) -------------------
otelcol.receiver.otlp "in" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.grafanacloud.input]
  }
}

otelcol.exporter.otlphttp "grafanacloud" {
  client {
    endpoint = sys.env("GC_OTLP_URL")
    auth     = otelcol.auth.basic.grafanacloud.handler
  }
}

otelcol.auth.basic "grafanacloud" {
  username = sys.env("GC_OTLP_USER")
  password = sys.env("GC_API_KEY")
}

// ---- Logs (Docker container logs → Grafana Cloud Loki) ----------------------
// Discovers all running containers, extracts the compose service name,
// and ships their stdout/stderr to Loki tagged with vm="vm-a".
discovery.docker "all" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.all.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.write.grafanacloud.receiver]
  labels     = { vm = "vm-a" }
}

loki.write "grafanacloud" {
  endpoint {
    url = sys.env("GC_LOKI_URL")
    basic_auth {
      username = sys.env("GC_LOKI_USER")
      password = sys.env("GC_API_KEY")
    }
  }
}
