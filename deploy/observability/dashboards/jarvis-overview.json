{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Your Grafana Cloud Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["jarvis", "observability"],
  "templating": {
    "list": [
      {
        "name": "vm",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(node_uname_info, vm)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_request_duration_seconds_count, service)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Jarvis — Services & Hosts",
  "uid": "jarvis-overview",
  "panels": [

    { "id": 1, "type": "row", "title": "Services (HTTP)", "gridPos": {"h":1,"w":24,"x":0,"y":0} },

    {
      "id": 2, "type": "timeseries",
      "title": "Request rate (req/s) by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":0,"y":1},
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(http_request_duration_seconds_count{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries",
      "title": "5xx error rate by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":12,"y":1},
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(http_request_duration_seconds_count{service=~\"$service\",status=~\"5..\"}[5m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries",
      "title": "p95 latency by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":0,"y":9},
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 5, "type": "timeseries",
      "title": "Requests in progress",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":12,"y":9},
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (http_requests_inprogress{service=~\"$service\"})", "legendFormat": "{{service}}" }
      ]
    },

    { "id": 10, "type": "row", "title": "VMs — Overview", "gridPos": {"h":1,"w":24,"x":0,"y":17} },

    {
      "id": 11, "type": "timeseries",
      "title": "CPU usage % by VM",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":8,"x":0,"y":18},
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by (vm) (rate(node_cpu_seconds_total{mode=\"idle\",vm=~\"$vm\"}[5m])) * 100)", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries",
      "title": "Memory used % by VM",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":8,"x":8,"y":18},
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes{vm=~\"$vm\"} / node_memory_MemTotal_bytes{vm=~\"$vm\"})) * 100", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 13, "type": "timeseries",
      "title": "Root filesystem available",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":8,"x":16,"y":18},
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_filesystem_avail_bytes{vm=~\"$vm\",mountpoint=\"/host/root\"}", "legendFormat": "{{vm}}" }
      ]
    },

    { "id": 20, "type": "row", "title": "VMs — Stats & Peaks", "gridPos": {"h":1,"w":24,"x":0,"y":26} },

    {
      "id": 21, "type": "stat",
      "title": "CPU % — current",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":4,"w":4,"x":0,"y":27},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":85}] }
        }, "overrides": []
      },
      "options": { "reduceOptions": {"calcs":["lastNotNull"],"fields":"","values":false}, "orientation":"auto", "colorMode":"background", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by (vm) (rate(node_cpu_seconds_total{mode=\"idle\",vm=~\"$vm\"}[5m])) * 100)", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 22, "type": "stat",
      "title": "CPU % — peak (window)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":4,"w":4,"x":4,"y":27},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":85}] }
        }, "overrides": []
      },
      "options": { "reduceOptions": {"calcs":["max"],"fields":"","values":false}, "orientation":"auto", "colorMode":"background", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by (vm) (rate(node_cpu_seconds_total{mode=\"idle\",vm=~\"$vm\"}[5m])) * 100)", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 23, "type": "stat",
      "title": "RAM % — current",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":4,"w":4,"x":8,"y":27},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}] }
        }, "overrides": []
      },
      "options": { "reduceOptions": {"calcs":["lastNotNull"],"fields":"","values":false}, "orientation":"auto", "colorMode":"background", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes{vm=~\"$vm\"} / node_memory_MemTotal_bytes{vm=~\"$vm\"})) * 100", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 24, "type": "stat",
      "title": "RAM % — peak (window)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":4,"w":4,"x":12,"y":27},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}] }
        }, "overrides": []
      },
      "options": { "reduceOptions": {"calcs":["max"],"fields":"","values":false}, "orientation":"auto", "colorMode":"background", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "(1 - (node_memory_MemAvailable_bytes{vm=~\"$vm\"} / node_memory_MemTotal_bytes{vm=~\"$vm\"})) * 100", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 25, "type": "stat",
      "title": "Load avg 1m",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":4,"w":4,"x":16,"y":27},
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": {"calcs":["lastNotNull"],"fields":"","values":false}, "orientation":"auto", "colorMode":"value", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "node_load1{vm=~\"$vm\"}", "legendFormat": "{{vm}}" }
      ]
    },
    {
      "id": 26, "type": "stat",
      "title": "Load avg 5m",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":4,"w":4,"x":20,"y":27},
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": {"calcs":["lastNotNull"],"fields":"","values":false}, "orientation":"auto", "colorMode":"value", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "node_load5{vm=~\"$vm\"}", "legendFormat": "{{vm}}" }
      ]
    },

    {
      "id": 27, "type": "timeseries",
      "title": "Network receive (bytes/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":8,"x":0,"y":31},
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_receive_bytes_total{device!=\"lo\",vm=~\"$vm\"}[5m])", "legendFormat": "{{vm}} {{device}}" }
      ]
    },
    {
      "id": 28, "type": "timeseries",
      "title": "Network transmit (bytes/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":8,"x":8,"y":31},
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\",vm=~\"$vm\"}[5m])", "legendFormat": "{{vm}} {{device}}" }
      ]
    },
    {
      "id": 29, "type": "timeseries",
      "title": "Load average (1m / 5m / 15m)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":8,"x":16,"y":31},
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_load1{vm=~\"$vm\"}",  "legendFormat": "{{vm}} 1m" },
        { "refId": "B", "expr": "node_load5{vm=~\"$vm\"}",  "legendFormat": "{{vm}} 5m" },
        { "refId": "C", "expr": "node_load15{vm=~\"$vm\"}", "legendFormat": "{{vm}} 15m" }
      ]
    },

    {
      "id": 30, "type": "timeseries",
      "title": "Disk read rate (bytes/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":0,"y":39},
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(node_disk_read_bytes_total{device!~\"loop.*\",vm=~\"$vm\"}[5m])", "legendFormat": "{{vm}} {{device}}" }
      ]
    },
    {
      "id": 31, "type": "timeseries",
      "title": "Disk write rate (bytes/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":12,"y":39},
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(node_disk_written_bytes_total{device!~\"loop.*\",vm=~\"$vm\"}[5m])", "legendFormat": "{{vm}} {{device}}" }
      ]
    },

    { "id": 40, "type": "row", "title": "Processes (per service)", "gridPos": {"h":1,"w":24,"x":0,"y":47} },

    {
      "id": 41, "type": "timeseries",
      "title": "Process RAM (RSS) by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":0,"y":48},
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{service=~\"$service\",vm=~\"$vm\"}", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 42, "type": "timeseries",
      "title": "Process CPU % by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":12,"y":48},
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{service=~\"$service\",vm=~\"$vm\"}[5m]) * 100", "legendFormat": "{{service}}" }
      ]
    },

    {
      "id": 43, "type": "timeseries",
      "title": "Open file descriptors by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":0,"y":56},
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_open_fds{service=~\"$service\",vm=~\"$vm\"}", "legendFormat": "{{service}} open" },
        { "refId": "B", "expr": "process_max_fds{service=~\"$service\",vm=~\"$vm\"}",  "legendFormat": "{{service}} limit" }
      ]
    },
    {
      "id": 44, "type": "timeseries",
      "title": "FD usage % of OS limit by service",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":8,"w":12,"x":12,"y":56},
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(process_open_fds{service=~\"$service\",vm=~\"$vm\"} / process_max_fds{service=~\"$service\",vm=~\"$vm\"}) * 100", "legendFormat": "{{service}}" }
      ]
    },

    {
      "id": 50, "type": "stat",
      "title": "Process RAM — current",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":6,"w":6,"x":0,"y":64},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":500000000},{"color":"red","value":1500000000}] }
        }, "overrides": []
      },
      "options": { "reduceOptions": {"calcs":["lastNotNull"],"fields":"","values":false}, "orientation":"auto", "colorMode":"background", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{service=~\"$service\",vm=~\"$vm\"}", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 51, "type": "stat",
      "title": "Process RAM — peak (window)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":6,"w":6,"x":6,"y":64},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":500000000},{"color":"red","value":1500000000}] }
        }, "overrides": []
      },
      "options": { "reduceOptions": {"calcs":["max"],"fields":"","values":false}, "orientation":"auto", "colorMode":"background", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{service=~\"$service\",vm=~\"$vm\"}", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 52, "type": "stat",
      "title": "Process CPU % — peak (window)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":6,"w":6,"x":12,"y":64},
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "reduceOptions": {"calcs":["max"],"fields":"","values":false}, "orientation":"auto", "colorMode":"value", "graphMode":"area", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{service=~\"$service\",vm=~\"$vm\"}[5m]) * 100", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 53, "type": "stat",
      "title": "Process uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": {"h":6,"w":6,"x":18,"y":64},
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": {"calcs":["lastNotNull"],"fields":"","values":false}, "orientation":"auto", "colorMode":"value", "graphMode":"none", "justifyMode":"auto", "textMode":"auto" },
      "targets": [
        { "refId": "A", "expr": "time() - process_start_time_seconds{service=~\"$service\",vm=~\"$vm\"}", "legendFormat": "{{service}}" }
      ]
    }

  ]
}
