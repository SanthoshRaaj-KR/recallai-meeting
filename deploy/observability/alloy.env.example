# Grafana Cloud credentials for the Alloy agent on each VM.
# Copy to deploy/observability/alloy.env on BOTH VMs and fill in.
# alloy.env is gitignored — never commit real tokens.
#
# Where to find everything (takes ~3 minutes):
#   1. Create a free stack at https://grafana.com/  (Hobby/Free tier).
#   2. Go to grafana.com → your stack → "Details" page.
#      You will see separate sections for Prometheus, Loki, and OTLP —
#      each has its own URL and a numeric User/Instance ID.
#   3. Create ONE API token that covers all three:
#      grafana.com → My Account → Security → Access Policies
#        → New Access Policy → tick: metrics:write, logs:write, traces:write
#        → Add token → copy it (shown only once).
#      Use that single token for all the *_KEY / *_PASS fields below.

# ---- Metrics (Prometheus remote_write → Mimir) ----
# Stack Details → Prometheus → "Remote Write Endpoint"
GC_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
# Stack Details → Prometheus → "Username / Instance ID"
GC_PROM_USER=000000

# ---- Logs (Loki push) ----
# Stack Details → Loki → "URL"  (append /loki/api/v1/push yourself)
GC_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# Stack Details → Loki → "User"
GC_LOKI_USER=000000

# ---- Traces (OTLP gateway → Tempo) ----
# Stack Details → OpenTelemetry (OTLP) → "Endpoint"
GC_OTLP_URL=https://otlp-gateway-prod-REGION.grafana.net/otlp
# Stack Details → OpenTelemetry (OTLP) → "Instance ID"
GC_OTLP_USER=000000

# ---- Shared API token (used as password for all three above) ----
# Access Policies → your policy → token value
GC_API_KEY=glc_REPLACE_WITH_TOKEN
