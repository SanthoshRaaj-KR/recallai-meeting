# Grafana Cloud credentials for the Alloy agent on each VM.
# Copy to deploy/observability/alloy.env on BOTH VMs and fill in.
# alloy.env is gitignored — never commit real tokens.
#
# Where to find these (Grafana Cloud → your stack):
#   1. Create a free stack at https://grafana.com/  (Hobby/Free tier).
#   2. Metrics:  Connections → Prometheus → "Sending metrics" panel:
#        GC_PROM_URL  = the remote_write endpoint  (…/api/prom/push)
#        GC_PROM_USER = the numeric "Username / Instance ID"
#   3. Traces:   Connections → OpenTelemetry (OTLP)  panel:
#        GC_OTLP_URL  = the OTLP endpoint            (…/otlp)
#        GC_OTLP_USER = the numeric OTLP Instance ID
#   4. Token:    Create one Access Policy token with metrics:write + traces:write,
#                then reuse it for all the *_KEY / *_PASS fields below.

# ---- Metrics (Prometheus remote_write) ----
GC_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GC_PROM_USER=000000
GC_API_KEY=glc_REPLACE_WITH_TOKEN

# ---- Traces (OTLP gateway → Tempo) ----
GC_OTLP_URL=https://otlp-gateway-prod-REGION.grafana.net/otlp
GC_OTLP_USER=000000
GC_OTLP_PASS=glc_REPLACE_WITH_TOKEN
