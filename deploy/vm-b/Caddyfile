# VM-B reverse proxy. Domain is nip.io (free wildcard DNS: <anything>.20-6-9-169.nip.io
# resolves to 20.6.9.169) since there's no purchased domain for VM-B yet — swap
# for a real domain later if you get one; just update this one line.
# Caddy auto-provisions Let's Encrypt TLS for the domain.
#
# Path convention (must match the frontend's VITE_* base URLs, SERVICE_MAP §6):
#   /conf-api/*  → confluence-service:8001   (review/* + pipeline SSE)
#   /org-api/*   → org-service:8003          (auth/users/teams/...)
# handle_path strips the prefix so the upstream sees its native routes
# (e.g. /conf-api/review/pipeline/start → /review/pipeline/start).

api.20-6-9-169.nip.io {
	handle_path /conf-api/* {
		reverse_proxy confluence-service:8001 {
			# Stream SSE immediately — no buffering — so the 20-min
			# /review/pipeline/{job}/stream survives.
			flush_interval -1
		}
	}

	handle_path /org-api/* {
		reverse_proxy org-service:8003
	}

	respond /health 200
}
