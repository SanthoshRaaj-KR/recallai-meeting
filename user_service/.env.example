# ── Supabase (shared with bot + confluence services) ──────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for development only.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001
