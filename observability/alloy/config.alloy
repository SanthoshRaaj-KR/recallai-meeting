// Grafana Alloy — local dev collector config.
// Run alongside docker-compose.local.yml via docker-compose.observability.yml.
//
// Phase 1 (active): host metrics + app /metrics scraping -> Prometheus remote_write.
// Phase 2/3 blocks below are inactive (commented) until logs/traces phases start —
// see Confluence/OBSERVABILITY_PLAN.md.

logging {
	level  = "info"
	format = "logfmt"
}

// ---------------------------------------------------------------------------
// Phase 1: METRICS
// ---------------------------------------------------------------------------

// Host metrics. Requires /proc, /sys, / mounted read-only into the alloy
// container (see docker-compose.observability.yml) with matching *_path args.
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"
}

prometheus.scrape "host_metrics" {
	targets    = prometheus.exporter.unix.host.targets
	forward_to = [prometheus.remote_write.local.receiver]
	job_name   = "host"
}

// Application services. Each FastAPI service must expose GET /metrics
// (Phase 1 app task — see OBSERVABILITY_PLAN.md Phase 1, step 2).
prometheus.scrape "app_services" {
	targets = [
		{"__address__" = "bot-service:8000", "job" = "bot-service", "service" = "bot-service"},
		{"__address__" = "confluence-service:8001", "job" = "confluence-service", "service" = "confluence-service"},
		{"__address__" = "org-service:8003", "job" = "org-service", "service" = "org-service"},
	]
	metrics_path = "/metrics"
	forward_to   = [prometheus.remote_write.local.receiver]
	job_name     = "app-services"
}

// Alloy's own metrics (self-monitoring).
prometheus.scrape "alloy_self" {
	targets = [
		{"__address__" = "127.0.0.1:12345", "job" = "alloy"},
	]
	forward_to = [prometheus.remote_write.local.receiver]
	job_name   = "alloy"
}

prometheus.remote_write "local" {
	endpoint {
		url = "http://prometheus:9090/api/v1/write"
	}
}

