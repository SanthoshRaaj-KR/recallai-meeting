# Recall.ai
RECALL_API_KEY=your_recall_api_key_here
RECALL_API_REGION=ap-northeast-1
RECALL_WEBHOOK_SECRET=your_recall_webhook_secret_here

# Your ngrok/tunnel URL (run: ngrok http 8000, then paste URL here)
OUTPUT_MEDIA_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app

# Bot configuration
MEETING_URL=https://meet.google.com/your-meeting-code
BOT_NAME=Jarvis
STREAMING_MODE=prioritize_low_latency
LANGUAGE_CODE=en
JARVIS_AGENT_MODEL=gpt-5-mini
RECALL_TRANSCRIPT_PROVIDER=recallai_streaming
# Note: for AssemblyAI via Recall BYOB, add the Assembly API key in the Recall
# transcription credentials dashboard. The app does not send ASSEMBLY_API directly.
# Keep ASSEMBLY_API locally only if you need it elsewhere in your own tooling.
ASSEMBLY_API=your_assemblyai_api_key_here

=======
# Server — recall_bridge (bot-launcher) on 8000; jarvis_agentic (confluence-logic) on 8001
>>>>>>> confluence
APP_HOST=0.0.0.0
APP_PORT=8000

# Internal URL of the jarvis_agentic service (set to Azure service DNS in production)
CONFLUENCE_LOGIC_URL=http://localhost:8001

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
# Legacy JARVIS_TTS_* vars removed in Phase 03 — Cartesia voice is configured via JARVIS_LK_* (see below).

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=confluence-kb
PINECONE_INDEX_DIMENSION=1024

# LiveKit Agents (Phase 03 — agent_worker.py)
# Provider passed to inference.TTS(f"{JARVIS_LK_TTS_PROVIDER}/sonic-3", ...)
JARVIS_LK_TTS_PROVIDER=cartesia
# Cartesia voice UUID — audition at https://play.cartesia.ai/voices
JARVIS_LK_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# LLM model passed to inference.LLM(...). Must match CLAUDE.md ceiling (no above GPT-5).
JARVIS_LK_LLM=openai/gpt-5.4-nano
# Must match AgentServer(agent_name=...) in agent_worker.py AND AgentDispatchRequest(agent_name=...) in review/api.py
JARVIS_AGENT_WORKER_NAME=jarvis-agent
# Optional — only if NOT using LiveKit Inference for Cartesia. Leave unset to bill through LiveKit Cloud.
CARTESIA_API_KEY=your_cartesia_api_key_here

# --- Phase 4: Native voice agent (STT) -------------------------------------
# Deepgram Nova-3 STT is invoked via LiveKit Inference and reuses the existing
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET above — no separate Deepgram key required
# when LiveKit Cloud is used. The agent_worker.py AgentSession instantiates:
#   inference.STT(model="deepgram/nova-3", language="multi")
#
# OPTIONAL — to use the direct livekit-plugins-deepgram plugin instead of the
# Inference path, install `pip install livekit-plugins-deepgram==1.5.9` and set:
# DEEPGRAM_API_KEY=
