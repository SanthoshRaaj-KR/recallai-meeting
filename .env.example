# Recall.ai
RECALL_API_KEY=your_recall_api_key_here
RECALL_API_REGION=ap-northeast-1
RECALL_WEBHOOK_SECRET=your_recall_webhook_secret_here

# Your ngrok/tunnel URL (run: ngrok http 8000, then paste URL here)
OUTPUT_MEDIA_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app

# Bot configuration
MEETING_URL=https://meet.google.com/your-meeting-code
BOT_NAME=Jarvis
STREAMING_MODE=prioritize_low_latency
LANGUAGE_CODE=en
JARVIS_AGENT_MODEL=gpt-5-mini
RECALL_TRANSCRIPT_PROVIDER=recallai_streaming
# Note: for AssemblyAI via Recall BYOB, add the Assembly API key in the Recall
# transcription credentials dashboard. The app does not send ASSEMBLY_API directly.
# Keep ASSEMBLY_API locally only if you need it elsewhere in your own tooling.
ASSEMBLY_API=your_assemblyai_api_key_here

# Server — recall_bridge (bot-launcher) on 8000; jarvis_agentic (confluence-logic) on 8001
APP_HOST=0.0.0.0
APP_PORT=8000

# Internal URL of the jarvis_agentic service (set to Azure service DNS in production)
CONFLUENCE_LOGIC_URL=http://localhost:8001

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
JARVIS_TTS_PROVIDER=openai
JARVIS_TTS_MODEL=gpt-4o-mini-tts
JARVIS_TTS_VOICE=alloy
JARVIS_TTS_SPEED=1.0

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=confluence-kb
PINECONE_INDEX_DIMENSION=1024
