LOCAL_OFFICE_SANDBOX_ROOT=./local_office_sandbox
LOCAL_OFFICE_STAGING_ROOT=./local_office_sandbox/.local_office_staging
LOCAL_OFFICE_ALLOWED_EXTENSIONS=.docx,.doc,.odt,.rtf,.xlsx,.xls,.ods,.csv
LOCAL_OFFICE_DEFAULT_DOC_FORMAT=docx
LOCAL_OFFICE_DEFAULT_SHEET_FORMAT=xlsx
LOCAL_OFFICE_OFFICE_BINARY=soffice
LOCAL_OFFICE_ENABLE_PINECONE=false
LOCAL_OFFICE_PINECONE_INDEX_NAME=local-office-kb
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
PINECONE_API_KEY=
RECALL_API_KEY=
RECALL_API_REGION=ap-northeast-1
WEBHOOK_URL=
MEETING_URL=
BOT_NAME=Jarvis
LANGUAGE_CODE=en
STREAMING_MODE=prioritize_low_latency
APP_HOST=0.0.0.0
APP_PORT=8000
JARVIS_AGENT_MODEL=gpt-5-mini
JARVIS_TTS_PROVIDER=openai
JARVIS_TTS_MODEL=gpt-4o-mini-tts
JARVIS_TTS_VOICE=echo
JARVIS_TTS_SPEED=1.0
