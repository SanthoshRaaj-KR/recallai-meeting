LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Microservice ports ─────────────────────────────────────────
# Bot service:        uv run uvicorn src.bot_service:app --port 8000
# Confluence service: uv run uvicorn src.recall_bridge:app --port 8001
# Org/user service:   uvicorn user_service.main:app --port 8003  (separate venv)

# ── Supabase (shared session store — both 8000 + 8001 use this) ─
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub MCP integration (optional — enables voice GitHub queries via Jarvis)
# Set GITHUB_TOKEN to a personal access token with repo scope to activate GitHub tools.
# When unset, the agent starts without GitHub tools (no crash, warning logged).
GITHUB_TOKEN=
# Optional: default GitHub repo for PR/issue queries (owner/repo format, e.g. myorg/myrepo)
GITHUB_DEFAULT_REPO=

# Post-meeting Confluence proposal pipeline
OPENAI_API_KEY=
MY_AGENT_REVIEW_MODEL=gpt-4o-mini
MY_AGENT_PIPELINE_MAX_PAGES=16
MY_AGENT_PIPELINE_MAX_SEARCH_TERMS=24

# Confluence REST fallback and apply path. Required even when Rovo MCP is on.
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_DOMAIN=your-domain.atlassian.net
ATLASSIAN_SPACE_KEY=

# Optional Rovo MCP retrieval path. Falls back to REST on empty/error.
ROVO_MCP_ENABLED=0
ROVO_MCP_BEARER_TOKEN=
ROVO_MCP_URL=https://mcp.atlassian.com/v1/mcp/authv2
